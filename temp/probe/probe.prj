<configuration>
  <platform key="Win_x86">
     <project>
        <executable>probe.exe</executable>
     </project>
  </platform>
  <platform key="Win_x64">
     <project>
        <executable>probe64.exe</executable>
     </project>
  </platform>
  <project>
     <namespace>probe</namespace>
     <template>mt_console</template>
  </project>
  <files>
     <module>
        <include>main.l</include>
     </module>
  </files>
</configuration>
