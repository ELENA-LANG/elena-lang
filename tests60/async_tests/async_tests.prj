<configuration>
  <platform key="Win_x86">
     <project>
        <executable>async_tests.exe</executable>
     </project>
  </platform>
  <platform key="Win_x64">
     <project>
        <executable>async_tests64.exe</executable>
     </project>
  </platform>
  <project>
     <namespace>async_tests</namespace>
     <template>mt_console</template>
     <autoextension>-1</autoextension>
  </project>
  <files>
     <module>
        <include>main.l</include>
        <include>basic.l</include>
        <include>cancellation.l</include>
     </module>
  </files>
</configuration>
