<configuration>
    <platform key="MacOS_ARM64">
        <project>
            <output>../../lib60_64</output>
        </project>
    </platform>
    <files>
        <module>
            <file>xmlnode.l</file>
            <file>xmldoc.l</file>
            <file>xmlformatter.l</file>
            <file>xmlreader.l</file>
       </module>
    </files>
    <manifest>
       <name>ELENA XML Library</name>
       <version>7.0.2</version>
       <author>Aleksey Rakov</author>
    </manifest>
    <project>
        <executable></executable>
        <options></options>
        <namespace>xml</namespace>
        <template>lib60</template>
    </project>
</configuration>
