<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <project>
     <namespace>logger</namespace>
     <template>lib60</template>
  </project>
  <platform key="Win_x86">
     <project>
        <output>..\..\lib60</output>
     </project>
  </platform>
  <platform key="Win_x64">
     <project>
        <output>..\..\lib60_64</output>
     </project>
  </platform>
  <platform key="Linux_AMD64">
     <project>
        <output>..\..\lib60_64_lnx</output>
     </project>
  </platform>
  <manifest>
     <name>ELENA Logger Library</name>
     <version>7.1.2</version>
     <author>Aleksey Rakov</author>
  </manifest>
  <files>
     <module>
        <include>common.l</include>
        <include>console_logger.l</include>
        <include>file_logger.l</include>
        <include>aggregate_logger.l</include>
        <include>bootstrap.l</include>
     </module>
  </files>
</configuration>