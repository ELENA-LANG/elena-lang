<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <platform key="Win_x86">
        <project>
            <output>..\..\lib60</output>
        </project>
    </platform>
    <platform key="Win_x64">
        <project>
            <output>..\..\lib60_64</output>
        </project>
    </platform>
    <project>
        <namespace>opengl</namespace>
        <template>lib60</template>
    </project>
    <manifest>
        <name>ELENA OpenGL Wrapper</name>
        <version>7.3.6</version>
        <author>Aleksey Rakov, ELENA-LANG Org</author>
    </manifest>
    <files>
        <module name="common">
            <include>common\datatypes.l</include>
            <include>common\interfaces.l</include>
        </module>
        <module name="externals'primitives">
            <include>externals\primitives\templates.l</include>
            <include>externals\primitives\func_declarations.l</include>
        </module>
        <module name="externals">
            <include>externals\common.l</include>
            <include>externals\datatypes.l</include>
            <include>externals\glad.l</include>
            <include>externals\wgl.l</include>
        </module>
        <module>
            <file>forms_intergration.l</file>
            <include>common.l</include>
            <include>engine.l</include>
            <include>win_app.l</include>
        </module>
    </files>
</configuration>