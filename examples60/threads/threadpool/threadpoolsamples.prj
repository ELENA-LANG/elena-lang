<configuration>
    <platform key="Win_x86">
        <project>
           <executable>threadpoolsamples</executable>
        </project>
    </platform>
    <platform key="Win_x64">
        <project>
           <executable>threadpoolsamples64</executable>
        </project>
    </platform>
    <files>
        <module>
            <file>sample1.l</file>
            <file>sample2.l</file>
            <file>threadpool.l</file>
        </module>
    </files>
    <project>
        <options></options>
        <namespace>threadpoolsamples</namespace>
        <template>mt_console</template>
    </project>
</configuration>