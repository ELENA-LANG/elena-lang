<configuration>
  <platform key="Win_x86">
     <project>
        <executable>graphs.exe</executable>
     </project>
  </platform>
  <platform key="Win_x64">
     <project>
        <executable>graphs64.exe</executable>
     </project>
  </platform>
  <project>
     <namespace>graphs</namespace>
     <template>gui</template>
  </project>
  <files>
     <module>
        <include>interfaces.l</include>
        <include>controller.l</include>
        <include>factory.l</include>
        <include>graphs.l</include>
        <include>script.l</include>
     </module>
  </files>
  <forwards>
     <forward key="ScriptFunction">graphs'ScriptInterpreter</forward>
  </forwards>
  <constants>
     <constant key="script_file">factory.ls2</constant>
  </constants>
</configuration>

