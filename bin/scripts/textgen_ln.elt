public Program() {
  var list := system'io'File.readContent("@list_path");
  var script := system'io'File.readContent("@script_path");

  var output := textgen'TextGen.parseAsLineSeparated(list, script);

  var path := "@output_path";
  if (path.isNonempty()) {
    system'io'File.saveContent(path, output) 
  };

  system'Console.writeLine(output);
}
