<configuration>
  <platform key="MacOS_ARM64">
     <externals>
        <external key="$rt">/usr/local/lib/elena/libelenavm60_64.dylib</external>
     </externals>
  </platform>
  <system>
     <platform>4352</platform>
  </system>
  <project>
     <template>lib60</template>
  </project>
  <forwards>
     <forward key="$system_entry">system'core_routines'vm_sta_start</forward>
     <forward key="$symbol_entry">system'$private'entrySymbol</forward>
     <forward key="Program">$rootnamespace'Program|program</forward>
     <forward key="DefaultHandler">system'$private'ConsoleDefaultHandler</forward>
  </forwards>
</configuration>
